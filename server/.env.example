# Copy to .env and fill in. .env is git-ignored; this file is committed.
# On a deployed host, set these in the dashboard instead: there is no .env there.

# Local:    postgresql://postgres:devpassword@localhost:5432/alerto
#
# Supabase: Project Settings -> Database -> Connection string. Use the
# "Session pooler" or "Direct connection" string (port 5432), NOT the
# "Transaction pooler" (port 6543) -- db/pool.js keeps a small long-lived
# pool open, and the transaction pooler's prepared-statement caveats aren't
# worth it at this app's scale. pool.js already adds
# ssl: { rejectUnauthorized: false } for any non-localhost host, which is
# what Supabase requires -- no code change needed, just paste the string.
DATABASE_URL=postgresql://postgres:devpassword@localhost:5432/alerto

# Optional. Not read yet — server/lib/extractDeliverables.js uses a rule-based
# parser until this is wired up to a real model. See that file for the seam.
AI_API_KEY=

# Comma-separated, no trailing slash, no path. An origin is scheme + host + port.
CORS_ORIGINS=http://localhost:5173

# Set to production on your host. Express and several libraries behave better,
# including not sending stack traces to your users.
NODE_ENV=development

# Do NOT set PORT locally or on the host. The host sets it for you.

# ---------------------------------------------------------------------------
# Canvas LMS sync (server/lib/crypto.js, canvasClient.js, canvasSync.js)
# ---------------------------------------------------------------------------

# Required once you connect a Canvas account. 32 random bytes, base64-encoded.
# This key decrypts the stored access token -- it must live ONLY in this env
# var (set it in your host's dashboard too, never commit it, never put it in
# Supabase). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this key makes every already-stored token permanently
# undecryptable -- every user would need to reconnect their Canvas account.
CREDENTIAL_ENCRYPTION_KEY=

# Your school's Canvas domain, no trailing slash. For HAU this is Canvas
# itself (hau.instructure.com), not a custom portal -- Instructure is the
# company that makes Canvas. Confirm against the URL you actually log into.
CANVAS_BASE_URL=https://hau.instructure.com

# Standard 5-field cron syntax. Default (every 6 hours) is in
# server/lib/cronScheduler.js if this is left unset.
SYNC_CRON_SCHEDULE=0 */6 * * *
